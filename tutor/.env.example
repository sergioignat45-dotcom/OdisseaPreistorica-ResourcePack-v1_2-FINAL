# Copia questo file in ".env" (stesso nome ma senza ".example") e compila i campi.
# Il file ".env" resta sul tuo computer: NON va mai condiviso né caricato su GitHub.

# La chiave API di Anthropic (si crea su https://console.anthropic.com → "API keys").
# Senza questa riga l'app parte in modalità DEMO, con risposte di prova.
ANTHROPIC_API_KEY=

# Codice che la sorella dovrà scrivere la prima volta (opzionale ma CONSIGLIATO se l'app è online).
# Impedisce che chiunque conosca il link usi la tua chiave a tue spese.
ACCESS_CODE=

# Come si chiama il tutor (compare nell'app e quando si presenta).
TUTOR_NAME=Prof Claude

# Massimo di messaggi al giorno (protegge il tuo budget). Predefinito: 300.
DAILY_LIMIT=300

# --- Avanzate (di solito non servono) ---
# Modello: claude-opus-5-5 (predefinito, il più capace), claude-sonnet-5-5 (più veloce e circa metà prezzo),
# claude-haiku-5-5 (velocissimo ed economico).
# MODEL=claude-opus-5-5
# Quanto "ragionare" prima di rispondere: low (rapido, predefinito) | medium | high
# EFFORT=low
